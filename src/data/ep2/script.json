  "lines": [
    {
      "id": "s1-sys1",
      "scene": "s1",
      "speaker": "System",
      "text": "Main quest diperbarui. Temukan desa pertamamu.",
      "start": 0.9,
      "estimate": 2.5,
      "gapAfter": 0.8,
      "delivery": "system"
    },
    {
      "id": "s1-n1",
      "scene": "s1",
      "speaker": "Najmi",
      "text": "Hmm... membangun desa dari nol...",
      "start": 5.2,
      "estimate": 2.8,
      "gapAfter": 0.8,
      "delivery": "thinking"
    },
    {
      "id": "s1-n2",
      "scene": "s1",
      "speaker": "Najmi",
      "text": "Masalahnya, aku bahkan tidak punya peralatan untuk membangun rumah.",
      "start": 9.6,
      "estimate": 4.8,
      "gapAfter": 0.8,
      "delivery": "serious"
    },
    {
      "id": "s1-n3",
      "scene": "s1",
      "speaker": "Najmi",
      "text": "Tunggu sebentar...",
      "start": 16.2,
      "estimate": 1.6,
      "gapAfter": 0.6,
      "delivery": "thinking"
    },
    {
      "id": "s1-n4",
      "scene": "s1",
      "speaker": "Najmi",
      "text": "Kenapa aku harus mencari semua peralatan di dunia ini?",
      "start": 19.0,
      "estimate": 3.6,
      "gapAfter": 0.7,
      "delivery": "excited"
    },
    {
      "id": "s1-n5",
      "scene": "s1",
      "speaker": "Najmi",
      "text": "Aku masih punya akses ke duniaku sendiri!",
      "start": 23.8,
      "estimate": 3.0,
      "gapAfter": 0.8,
      "delivery": "confident"
    },
    {
      "id": "s2-sys1",
      "scene": "s2",
      "speaker": "System",
      "text": "Host, apakah Anda membutuhkan bantuan?",
      "start": 31.0,
      "estimate": 2.4,
      "gapAfter": 0.8,
      "delivery": "system"
    },
    {
      "id": "s2-n1",
      "scene": "s2",
      "speaker": "Najmi",
      "text": "System, apa saja yang kubutuhkan untuk memulai sebuah desa?",
      "start": 34.6,
      "estimate": 4.0,
      "gapAfter": 0.8,
      "delivery": "serious"
    },
    {
      "id": "s2-sys2",
      "scene": "s2",
      "speaker": "System",
      "text": "Untuk memulai pembangunan pemukiman, Host membutuhkan beberapa sumber daya.",
      "start": 39.6,
      "estimate": 4.8,
      "gapAfter": 1.0,
      "delivery": "system"
    },
    {
      "id": "s2-sys3",
      "scene": "s2",
      "speaker": "System",
      "text": "Disarankan untuk mempersiapkan kebutuhan dasar sebelum memulai pembangunan.",
      "start": 45.4,
      "estimate": 4.6,
      "gapAfter": 0.7,
      "delivery": "system"
    },
    {
      "id": "s2-n2",
      "scene": "s2",
      "speaker": "Najmi",
      "text": "Bagus! Kalau begitu, aku tahu harus mulai dari mana!",
      "start": 51.2,
      "estimate": 3.0,
      "gapAfter": 0.4,
      "delivery": "excited"
    },
    {
      "id": "s3-n1",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Pertama, peralatan untuk membersihkan lahan.",
      "start": 60.0,
      "estimate": 3.8,
      "gapAfter": 0.7,
      "delivery": "thinking"
    },
    {
      "id": "s3-n2",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Terus makanan, air minum...",
      "start": 65.2,
      "estimate": 2.8,
      "gapAfter": 0.6,
      "delivery": "thinking"
    },
    {
      "id": "s3-n3",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Dan yang paling penting...",
      "start": 69.2,
      "estimate": 2.4,
      "gapAfter": 0.5,
      "delivery": "serious"
    },
    {
      "id": "s3-n4",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Peralatan untuk membangun tempat tinggal!",
      "start": 72.8,
      "estimate": 3.4,
      "gapAfter": 0.8,
      "delivery": "excited"
    },
    {
      "id": "s3-n5",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "HAH?!",
      "ttsText": "[surprise-ah] HAH?!",
      "start": 84.0,
      "estimate": 1.2,
      "gapAfter": 0.6,
      "delivery": "shocked"
    },
    {
      "id": "s3-n6",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Uang tabunganku...",
      "start": 87.2,
      "estimate": 2.6,
      "gapAfter": 0.7,
      "delivery": "shocked"
    },
    {
      "id": "s3-n7",
      "scene": "s3",
      "speaker": "Najmi",
      "text": "Sepertinya aku harus benar-benar serius dengan proyek ini.",
      "ttsText": "[sigh] Sepertinya aku harus benar-benar serius dengan proyek ini.",
      "start": 91.4,
      "estimate": 5.0,
      "gapAfter": 0.8,
      "delivery": "sigh"
    },
    {
      "id": "s4-n1",
      "scene": "s4",
      "speaker": "Najmi",
      "text": "Ugh... ternyata membawa barang sebanyak ini tidak semudah yang kubayangkan.",
      "start": 108.0,
      "estimate": 5.6,
      "gapAfter": 0.9,
      "delivery": "tired"
    },
    {
      "id": "s4-n2",
      "scene": "s4",
      "speaker": "Najmi",
      "text": "Baiklah... setidaknya aku tidak datang dengan tangan kosong.",
      "start": 128.0,
      "estimate": 4.6,
      "gapAfter": 0.8,
      "delivery": "proud"
    },
    {
      "id": "s5-sys1",
      "scene": "s5",
      "speaker": "System",
      "text": "Persiapan Host telah selesai.",
      "start": 143.0,
      "estimate": 2.4,
      "gapAfter": 0.8,
      "delivery": "system"
    },
    {
      "id": "s5-n1",
      "scene": "s5",
      "speaker": "Najmi",
      "text": "Heh... tidak buruk.",
      "start": 150.0,
      "estimate": 1.8,
      "gapAfter": 0.5,
      "delivery": "proud"
    },
    {
      "id": "s5-n2",
      "scene": "s5",
      "speaker": "Najmi",
      "text": "Sepertinya petualangan ini akhirnya benar-benar dimulai.",
      "start": 152.8,
      "estimate": 3.6,
      "gapAfter": 0.8,
      "delivery": "smile"
    },
    {
      "id": "s6-n1",
      "scene": "s6",
      "speaker": "Najmi",
      "text": "...Hah?",
      "ttsText": "[pause 250ms] Hah?",
      "start": 174.6,
      "estimate": 1.0,
      "gapAfter": 0.7,
      "delivery": "whisper"
    },
    {
      "id": "s6-n2",
      "scene": "s6",
      "speaker": "Najmi",
      "text": "Jangan bilang...",
      "start": 179.5,
      "estimate": 1.8,
      "gapAfter": 0.5,
      "delivery": "whisper"
    },
    {
      "id": "s6-n3",
      "scene": "s6",
      "speaker": "Najmi",
      "text": "...ada sesuatu di sana?",
      "ttsText": "[pause 250ms] ada sesuatu di sana?",
      "start": 182.6,
      "estimate": 2.4,
      "gapAfter": 0.4,
      "delivery": "whisper"
    }
  ],
